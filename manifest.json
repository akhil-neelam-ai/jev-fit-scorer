{
  "action": {
    "default_icon": {
      "128": "icon128.png",
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "Worth Applying?"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "description": "Scores how well the job posting you have open fits your resume, using TypeSafe's Jev model.",
  "host_permissions": [
    "https://api.typesafe.ai/*"
  ],
  "icons": {
    "128": "icon128.png",
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png"
  },
  "manifest_version": 3,
  "name": "Worth Applying?",
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "version": "1.3.0"
}
